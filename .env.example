# binance_ai_bot_vp - copy to .env and edit.
#
# Every value here is also defaulted in config.py, so an empty .env runs with safe
# defaults: TESTNET on, TRADING off. Only override what you mean to change.
#
# Values marked PROVISIONAL are reasoned, not measured. Phase 0 replaces them with
# observed percentiles from real sessions - see CALIBRATION.md for what has already
# been found and what remains.

# ----------------------------------------------------------------- credentials
# Use a DEDICATED SUB-ACCOUNT and an IP-restricted key. This system must not share a
# rate-limit budget or a blast radius with anything else.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Both default to the safe setting. USE_TESTNET=false and TRADING_ENABLED=true are
# two separate deliberate acts; neither alone can place a real order.
USE_TESTNET=true
TRADING_ENABLED=false

# Touch this file to stop new entries on the next cycle. Existing positions keep
# being managed - halting reconciliation too would strand them.
KILL_SWITCH_FILE=KILL_SWITCH

# -------------------------------------------------------------------- universe
# Research wide, trade narrow: statistics need breadth, money needs depth.
UNIVERSE_SIZE=600
TRADE_UNIVERSE_SIZE=120
TRADE_MIN_24H_QUOTE_VOLUME=50000000
SYMBOL_DENYLIST=

# ------------------------------------------------------------- profile engine
# Profiles are built from 1m klines: full history, so live and replay compute
# identical levels.
VALUE_AREA_PCT=0.70
BIN_ATR_FRACTION=0.02
BIN_ATR_PERIOD_DAYS=14

HVN_PCT=0.70
LVN_PCT=0.35
LVN_MIN_WIDTH_BINS=2

# CALIBRATED from 14,185 symbol-sessions. Separate thresholds because a POC (an argmax)
# is ~2x more stable under re-binning than a value bound (a cumulative-sum crossing) at
# every percentile - the corpus confirms the asymmetry these were split for.
#   poc_shift  p50 0.62  p80 1.38  p90 4.78     va_shift  p50 1.16  p80 1.97  p90 3.00
# The POC threshold moved 1.0 -> 2.0: at 1.0 it rejected 24% of all sessions, the most
# aggressive gate in the system. There is a sharp break between p80=1.38 and p90=4.78,
# so 2.0 sits in the gap and cuts the unstable tail (~16%) instead of a quarter of the
# corpus. The VA threshold is already exactly p90 and is unchanged.
STABILITY_MAX_POC_SHIFT_BINS=2.0
STABILITY_MAX_VA_SHIFT_BINS=3.0

# CALIBRATED 1.25 -> 2.20 (p10 of 14,185 sessions). The synthetic fixture that produced
# 1.25 measured 1.29; REAL sessions start at 2.02 at p05, so 1.25 rejected 1.1% of the
# corpus - the gate looked like a quality filter and filtered nothing. The clearest
# confirmation that synthetic data cannot calibrate a distributional threshold.
POC_MIN_PROMINENCE=2.20
PROFILE_MIN_CANDLES=600
PROFILE_MIN_OCCUPIED_BINS=20
PROFILE_MIN_QUOTE_VOLUME=1000000
VA_MIN_WIDTH_ATR=0.05
VA_MAX_WIDTH_ATR=3.0

# --------------------------------------------------------- shape classifier
# CALIBRATED/REVIEWED against 14,185 sessions. va_range_ratio p10 0.331 p20 0.389
# p50 0.497, so 0.35 labels the most elongated ~13% as trend (~20% including migration).
# KEPT, but it is a choice not a discovery: the distribution is smooth and unimodal with
# no natural break, so no threshold on this axis is privileged by the data. Phase 4
# robustness decides whether it earns its place.
SHAPE_TREND_MAX_VA_RANGE_RATIO=0.35
SHAPE_TREND_MIN_POC_MIGRATION_ATR=0.5
SHAPE_P_MIN_POC_POSITION=0.65
SHAPE_B_MAX_POC_POSITION=0.35

# ---------------------------------------------------------------- acceptance
# The S2/S3 discriminator: volume per candle outside value, over this session's own
# volume per candle. The GAP between these two is as important as their values -
# inside it neither setup fires, which is what makes them mutually exclusive.
#
# WHICH QUANTITY DECIDES: "duration" (default) or "volume_rate".
#
# Acceptance is a claim about TIME - price is accepted when it trades outside value long
# enough for value to develop there. The volume-rate ratio below was a convenience proxy
# for that, and Phase 0 measured the PROXY as inert while the time-based measure it stood
# in for is strongly informative. Identical control, 14,268 excursions, one independent
# read each, session-clustered errors, five seeds:
#
#                          alone          within distance strata
#   time outside value     0.658-0.669    0.606-0.619   <- informative, seed-stable
#   volume rate ratio      0.545-0.550    ~0.50         <- null
#
# Continuation rate by time outside value, strictly monotone across every band:
#   0.8h+ 28.4%   2.0h+ 46.8%   5.2h+ 61.7%
#   1.2h+ 35.9%   3.2h+ 53.6%   8.5h+ 73.1%
#
# The crossover from reversion-dominant to continuation-dominant is at 2-3 hours, which is
# the auction-theory claim as a number. "volume_rate" is kept as the ABLATION ARM - a
# Phase 1 run exists under it and is the control for this change. See CALIBRATION.md 11 & 14.
ACCEPT_DISCRIMINATOR=duration

# Confirmation candles closed outside value. At the 15m default: 13 = 3.25h, 5 = 1.25h.
# Set from the DISTRIBUTION (p75 and p40 of duration at a decision point), not from
# whichever band scored best. The GAP between them is what keeps S2 and S3 mutually
# exclusive - inside it the verdict is PENDING and neither fires.
ACCEPT_MIN_CANDLES_OUTSIDE=13
REJECT_MAX_CANDLES_OUTSIDE=5

# The floor: below this an excursion is too short to describe at all, whatever the
# discriminator says.
ACCEPT_MIN_CANDLES=3

# Used only when ACCEPT_DISCRIMINATOR=volume_rate. Measured inert - see above.
ACCEPT_MIN_VOLUME_RATE_RATIO=0.80
REJECT_MAX_VOLUME_RATE_RATIO=0.45

# The denominator must not contain the numerator. Averaging over the whole session
# includes the excursion being measured, so the ratio drifts toward 1.0 in proportion
# to the excursion's LENGTH - and a session that OPENS outside value and never returns
# has no in-value candles at all, making the ratio exactly 1.000 regardless of volume.
# That was 22% of real excursions, every one of them clearing the acceptance threshold
# on a measurement containing no information. So the baseline comes from candles BEFORE
# the excursion; this is how many are required before their mean is trusted. Below it
# the prior session's rate is used; with neither, the verdict is NO_BASELINE and
# nothing trades. 6 at the 15m default is 90 minutes of independent reference.
ACCEPT_MIN_BASELINE_CANDLES=6

# -------------------------------------------------------------------- setups
CONFIRM_INTERVAL=15m

# ALL FOUR DISABLED BY DEFAULT. Phase 1 + the matched-random control (CALIBRATION.md
# finding 15) found no setup beats a random entry at the same symbol/session/direction/
# geometry - and S3-BRK is measurably WORSE than one (lift -0.39R to -0.47R, 95% CI
# excludes zero on the negative side, replicated under both acceptance discriminators).
# S1-POC and S2-VAR show no separation either way (CIs straddle zero). S1-LVN has too
# few trades (n=14) for its own gate to mean anything yet.
#
# The pre-committed rule from Phase 0: a setup failing its phase gate is disabled by
# default, not loosened. None of the four passed. Flip one to true only after a specific
# fix and a fresh Phase 1 + control result support it - not as a blanket override.
S1_POC_ENABLED=false
S1_LVN_ENABLED=false
S2_ENABLED=false
S3_ENABLED=false

# Distances BETWEEN PROFILE LEVELS are denominated in VALUE WIDTH, never ATR. Daily
# ATR is a 14-day average range; a value area is a fraction of one session's range,
# and on a quiet day they differ by ~10x. Four thresholds were originally mis-scaled
# this way and one of them was mathematically unsatisfiable. ATR remains the right
# unit for volatility-scaled distances only: stop buffers and touch tolerances.
S1_MIN_OPEN_DISTANCE_VA_FRACTION=0.15
S1_LVN_MIN_POC_DISTANCE_VA_FRACTION=0.25
S2_MIN_EXCURSION_VA_FRACTION=0.20
S3_BREAK_MIN_VA_FRACTION=0.30
# A small noise floor only - acceptance, not distance, decides whether a break is real.
S3_BREAK_MIN_ATR=0.10

S1_TOUCH_TOLERANCE_ATR=0.10
S1_MIN_CONFIRMATIONS=1
S1_STOP_BUFFER_ATR=0.30
S1_STOP_BUFFER_TICKS=3
S1_LVN_STOP_BUFFER_ATR=0.15
S2_STOP_BUFFER_ATR=0.20
# Now actually enforced. Repeated fades of one excursion is the specific failure
# mode of a reversion setup: each looks like a fresh signal, together they are one
# increasingly wrong opinion averaged into at worse prices.
S2_MAX_PER_SESSION=2
S3_PULLBACK_MAX_DEPTH=0.25
S3_STOP_BUFFER_ATR=0.25
S3_REQUIRE_DEVELOPING_POC_MIGRATION=true
S3_WIDEN_STOP_PAST_LVN=true

# Opinion-bearing overlays. OFF until a Phase 3 ablation shows a replicated positive
# contribution on the gated population.
S2_REQUIRE_BALANCED_SHAPE=false
S2_REQUIRE_POOR_EXTREME=false

# ---------------------------------------------------------------- opinion gates
# All OFF by default, all already wired into every setup's gate profile - so enabling
# one is a config change, not a code change. That is what makes the ablation a sweep.
GATE_SHAPE_OPPOSED_ENABLED=false
GATE_DELTA_OPPOSED_ENABLED=false
GATE_HTF_VALUE_OPPOSED_ENABLED=false
GATE_STOP_INSIDE_HVN_ENABLED=false
GATE_TARGET_BEHIND_HVN_ENABLED=false

# ------------------------------------------------------------------ targeting
# fixed_r tests the source material's claim as stated. structural uses the levels the
# profile actually produced and is the measured challenger.
TARGET_MODE=fixed_r
TARGET_FIXED_R=2.0
TARGET_MIN_R=1.2

# ---------------------------------------------------------------- arbitration
# sequential: an open balance position runs to its own stop even when acceptance
# later confirms against it. flip closes and reverses. Phase 4 decides.
ARBITER_MODE=sequential
# LVN_FIRST is a reasoned PRIOR, not a result: theory predicts the thin area is the
# reaction level. Phase 1's head-to-head decides it.
S1_ARBITRATION=LVN_FIRST
MAX_SETUPS_PER_SESSION_PER_SYMBOL=3
CLOSE_AT_SESSION_END=false

# ------------------------------------------------------------------------ risk
# Size comes from the STOP, never from leverage: a stop-out costs RISK_PCT of equity
# by construction, and leverage only decides margin efficiency.
RISK_PCT=0.0025
LEVERAGE=5
MARGIN_TYPE=ISOLATED

# Notional equity for OBSERVATION RUNS ONLY (TRADING_ENABLED=false with no account
# access). Without it, sizing refuses every candidate as "equity is zero" and the
# observation journal fills with sizing failures instead of the sized candidates it
# exists to record. It can never size a real order - the fallback is gated on
# TRADING_ENABLED being false; with trading on and no account access the system refuses
# to trade rather than invent a balance.
PAPER_EQUITY=10000

# Alt perps are close to a one-factor market, so same-direction exposure concentrates
# rather than diversifies. The per-direction cap is the binding one in practice.
MAX_CONCURRENT_POSITIONS=6
MAX_CONCURRENT_PER_DIRECTION=4
DAILY_LOSS_LIMIT_R=3.0
CONSECUTIVE_LOSS_LIMIT=4
STOP_MIN_COST_MULTIPLE=3.0
STOP_MAX_ATR=2.0

# ------------------------------------------------------------------- execution
# GTX is post-only: Binance rejects it rather than crossing, which guarantees maker
# fees and guarantees we never accidentally pay the spread.
ENTRY_ORDER_TYPE=LIMIT
ENTRY_TIME_IN_FORCE=GTX
ENTRY_TIMEOUT_SECONDS=900
ENTRY_OFFSET_TICKS=0

# How long open() may BLOCK waiting for a fill, as distinct from how long the order is
# allowed to REST (ENTRY_TIMEOUT_SECONDS above). These were once the same number, which
# stalled the whole bot for fifteen minutes whenever a passive entry did not fill - and
# not filling is the ordinary outcome for a post-only order at a level. Reconcile never
# ran, so open positions went unmonitored and a flat position kept its survivor order.
# Entries are tracked state now; this window only catches the immediate fill. Keep it
# well under SCAN_INTERVAL_SECONDS.
ENTRY_FAST_FILL_SECONDS=8
ENTRY_POLL_SECONDS=2.0

# MARK_PRICE stops: the mark is index-anchored, so it is far harder to wick than last
# price on a thin alt.
STOP_WORKING_TYPE=MARK_PRICE
STOP_PRICE_PROTECT=true

FEE_MAKER=0.0002
FEE_TAKER=0.0005
SLIPPAGE_MODEL_BPS=2.0
MAX_SPREAD_BPS=6.0

# --------------------------------------------------------------------- runtime
SCAN_INTERVAL_SECONDS=60
REST_THROTTLE_SECONDS=0.15
FUNDING_GUARD_MINUTES=15
DEVELOPING_MIN_ELAPSED_MINUTES=120
DEVELOPING_MIN_VOLUME_FRACTION=0.15

DB_PATH=vp_state.sqlite
PARQUET_DIR=data_cache
LOG_PATH=logs/vp_bot.log
LOG_LEVEL=INFO
HEARTBEAT_EVERY_CYCLES=15

# ----------------------------------------------------------- feed recorder (ops/feed_recorder.py)
# Public market-data streams only - no API key is used by the recorder.
# Empty FEED_SYMBOLS = the FEED_SYMBOL_COUNT USDT perpetuals with the largest 24h quote volume.
FEED_SYMBOLS=
FEED_SYMBOL_COUNT=50
FEED_QUOTE_ASSET=USDT
FEED_OUT_DIR=feed_data
FEED_DEPTH_SAMPLE_SECONDS=5
FEED_SYMBOLS_PER_SOCKET=100

# ------------------------------------------------------------ live scan universe
# SCAN_SYMBOLS pins the live list (order kept, volume floor bypassed). Empty = top
# TRADE_UNIVERSE_SIZE by 24h quote volume. Ticker lookups are cached this many seconds.
SCAN_SYMBOLS=
WATCHLIST_REFRESH_SECONDS=300

# ------------------------------------------------------------------ live websockets
# OFF by default. REST stays the source of truth; the feed only fills the candle cache.
WS_ENABLED=false
WS_SYMBOLS_PER_SOCKET=100
WS_STALE_SECONDS=45
WS_WATCHDOG_INTERVAL_SECONDS=15
WS_RESTART_COOLDOWN_SECONDS=30
